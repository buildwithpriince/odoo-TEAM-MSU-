# GlobeTrotter Backend Database Configuration
DATABASE_URL=postgresql://globetrotter_user:globetrotter_pass@localhost:5432/globetrotter_db

# Postgres Connection Parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=globetrotter_db
POSTGRES_USER=globetrotter_user
POSTGRES_PASSWORD=globetrotter_pass

# Application Environment
ENVIRONMENT=development
PORT=8000
